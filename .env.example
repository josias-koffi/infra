# Local values for make targets. Never committed (.gitignore).
# In CI the same names are GitHub secrets.

# Dokploy panel URL
DOKPLOY_URL=https://dokploy.example.com

# R2 bucket holding the OpenTofu states (create it once, see docs)
TF_STATE_BUCKET=

# R2 backup buckets, one per environment
R2_BACKUP_BUCKET_PROD=
R2_BACKUP_BUCKET_STAGING=

# Dokploy panel API key (Settings > Profile > API keys)
DOKPLOY_API_KEY=

# R2 — OpenTofu state bucket
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 — backup buckets, one bucket-scoped token per environment
R2_BACKUP_PROD_ACCESS_KEY_ID=
R2_BACKUP_PROD_SECRET_ACCESS_KEY=
R2_BACKUP_STAGING_ACCESS_KEY_ID=
R2_BACKUP_STAGING_SECRET_ACCESS_KEY=

# Cloudflare — one account token for every zone of the account (dns: cloudflare,
# the default) and the add-ons: Zone → Zone → Read and Zone → DNS → Edit on all
# zones; Account → Workers R2 Storage → Edit and Account → Account API Tokens →
# Edit (buckets and their scoped tokens). The account id (any zone's Overview,
# right column) limits the zones to that account and is required for buckets.
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Deprecated: single zone, used only for a host no zone of the account covers.
CF_ZONE_ID=

# Deploys run in this repo (deploy-app.yml): read access to the app repos —
# fine-grained token, Contents: Read on every app repository.
APP_REPOS_READ_TOKEN=
# Started from the app repos (dispatch-deploy.yml): fine-grained token,
# Actions: Read and write on THIS repo only. scripts/onboard-app.sh copies it to
# each app repo; it can start a deploy, never read a credential.
INFRA_DEPLOY_TOKEN=

# Optional — pull credentials for private GHCR images
GHCR_USERNAME=
GHCR_TOKEN=

# Remote nodes (make node-key)
NODE_SSH_PUBLIC_KEY=
NODE_SSH_PRIVATE_KEY=

# Ansible
NODE_ADMIN_USER=devops
SWAP_SIZE_MB=0
