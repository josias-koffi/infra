# Local values for make targets. Never committed (.gitignore).
# In CI the same names are GitHub secrets.

# Dokploy panel URL
DOKPLOY_URL=https://dokploy.example.com

# R2 bucket holding the OpenTofu states (create it once, see docs)
TF_STATE_BUCKET=

# R2 backup buckets, one per environment
R2_BACKUP_BUCKET_PROD=
R2_BACKUP_BUCKET_STAGING=

# Dokploy panel API key (Settings > Profile > API keys)
DOKPLOY_API_KEY=

# R2 — OpenTofu state bucket
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 — backup buckets, one bucket-scoped token per environment
R2_BACKUP_PROD_ACCESS_KEY_ID=
R2_BACKUP_PROD_SECRET_ACCESS_KEY=
R2_BACKUP_STAGING_ACCESS_KEY_ID=
R2_BACKUP_STAGING_SECRET_ACCESS_KEY=

# Cloudflare DNS of the apps (dns: cloudflare, the default) — token
# Zone → DNS → Edit on the zone, and that zone's id (Overview, right column).
# Pushed to an app repo with scripts/set-secrets.sh --app owner/app.
CF_API_TOKEN=
CF_ZONE_ID=

# Optional — pull credentials for private GHCR images
GHCR_USERNAME=
GHCR_TOKEN=

# Remote nodes (make node-key)
NODE_SSH_PUBLIC_KEY=
NODE_SSH_PRIVATE_KEY=

# Ansible
NODE_ADMIN_USER=devops
SWAP_SIZE_MB=0
